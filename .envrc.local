export SPOTIFY_PRIVATE=1
# messes up my ability to delete from private todo playlists from here
# - set in backup.sh and backup_private.sh for better targeting
#export SPOTIFY_PUBLIC_ONLY=1
unset SPOTIFY_PUBLIC_ONLY
unset SPOTIFY_PRIVATE_ONLY

if [ "$(curl -sS ifconfig.co/json | jq -r '.country')" = 'China' ]; then
    echo
    echo "Running in China, skipping github.com check as it's slow and often times out"
    echo "but api.spotify.com is more reliable and the more important site to be able"
    echo "to iterate the playlist API downloads"
    echo
    export CHECK_INTERNET_IMPORTANT_WEBSITES='api.spotify.com'
else
    export CHECK_INTERNET_IMPORTANT_WEBSITES='api.spotify.com github.com'
fi
